# 1. Copy this file and rename it to .env.local (development) or .env (docker-compose runtime)
# 2. Update the environment variables below.
# 3. Do not commit real secrets.

# REQUIRED SETTINGS
# #################
# URL pointing to the LiveKit server (example: `wss://my-livekit-project.livekit.cloud` or `ws://livekit:7880`).
LIVEKIT_URL=wss://livekit.local:8445
# Client-side URL used by the frontend to connect to LiveKit directly.
NEXT_PUBLIC_LIVEKIT_URL=wss://livekit.local:8445

# Optional: required only when using server-side token generation (`/api/connection-details`).
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=


# OPTIONAL SETTINGS
# #################
# Recording
# S3_KEY_ID=
# S3_KEY_SECRET=
# S3_ENDPOINT=
# S3_BUCKET=
# S3_REGION=

# PUBLIC
# Default room that users are redirected to from `/`.
# NEXT_PUBLIC_DEFAULT_ROOM=lobby

# Uncomment settings menu when using a LiveKit Cloud, it'll enable Krisp noise filters.
# NEXT_PUBLIC_SHOW_SETTINGS_MENU=true
# NEXT_PUBLIC_LK_RECORD_ENDPOINT=/api/record

# Optional, to pipe logs to datadog
# NEXT_PUBLIC_DATADOG_CLIENT_TOKEN=client-token
# NEXT_PUBLIC_DATADOG_SITE=datadog-site
